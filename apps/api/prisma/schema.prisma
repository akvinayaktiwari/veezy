generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id        String    @id @default(uuid()) @db.Uuid
  name      String
  userId    String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  agents    Agent[]
  bookings  Booking[]
  leads     Lead[]

  @@map("tenants")
}

model Agent {
  id              String    @id @default(uuid()) @db.Uuid
  tenantId        String    @db.Uuid
  name            String
  knowledge       String
  publicLink      String    @unique @default(uuid())
  linkExpiryHours Int       @default(24)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  bookings        Booking[]
  leads           Lead[]

  @@index([tenantId])
  @@index([publicLink])
  @@map("agents")
}

model Lead {
  id        String    @id @default(uuid()) @db.Uuid
  agentId   String    @db.Uuid
  tenantId  String    @db.Uuid
  name      String
  email     String
  bookedAt  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  bookings  Booking[]
  agent     Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([agentId])
  @@index([tenantId])
  @@index([email])
  @@map("leads")
}

model Booking {
  id           String        @id @default(uuid()) @db.Uuid
  leadId       String        @db.Uuid
  agentId      String        @db.Uuid
  tenantId     String        @db.Uuid
  scheduledAt  DateTime
  status       BookingStatus @default(PENDING)
  expiresAt    DateTime
  meetingToken String        @unique @default(uuid())
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  agent        Agent         @relation(fields: [agentId], references: [id], onDelete: Cascade)
  lead         Lead          @relation(fields: [leadId], references: [id], onDelete: Cascade)
  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  voiceSession VoiceSession?

  @@index([leadId])
  @@index([agentId])
  @@index([tenantId])
  @@index([status])
  @@index([expiresAt])
  @@index([meetingToken])
  @@map("bookings")
}

model VoiceSession {
  id              String    @id @default(uuid()) @db.Uuid
  bookingId       String    @unique @db.Uuid
  livekitRoomName String
  sessionId       String    @unique
  transcript      String?
  startedAt       DateTime  @default(now())
  endedAt         DateTime?
  durationSeconds Int?
  status          String    @default("active")
  metadata        Json?
  booking         Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@index([sessionId])
  @@index([status])
  @@map("voice_sessions")
}

enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  EXPIRED
  CANCELLED
}
