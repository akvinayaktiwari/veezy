# ============================================
# PRODUCTION ENVIRONMENT VARIABLES TEMPLATE
# Copy to .env.prod and fill in your values
# Usage: docker compose -f docker-compose.prod.yml --env-file .env.prod up
# ============================================

# ------------------ Database ------------------
# PostgreSQL credentials (change in production!)
POSTGRES_PASSWORD=your_secure_postgres_password_here

# ------------------ Supabase ------------------
# Get these from: https://app.supabase.com/project/_/settings/api
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
SUPABASE_ANON_KEY=your_anon_key_here

# Public Supabase (for frontend)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# ------------------ LiveKit ------------------
# Get these from: https://cloud.livekit.io/projects
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# Public LiveKit URL (for frontend WebRTC)
NEXT_PUBLIC_LIVEKIT_URL=wss://your-project.livekit.cloud

# ------------------ Google Gemini AI ------------------
# Get from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ------------------ Application URLs ------------------
# API URL for frontend (internal Docker network or public domain)
NEXT_PUBLIC_API_URL=http://nestjs-api:4000
# For production with reverse proxy, use: https://api.yourdomain.com

# Frontend URL for CORS (internal Docker network or public domain)
FRONTEND_URL=http://nextjs-web:3000
# For production: https://yourdomain.com

# API URL for voice agent
API_URL=http://nestjs-api:4000

# ------------------ Security ------------------
# JWT Secret for NestJS (generate secure random string)
JWT_SECRET=your_super_secret_jwt_key_at_least_32_chars_long

# ------------------ Optional ------------------
# Node environment (leave as production)
NODE_ENV=production

# Logging level (info, debug, warn, error)
LOG_LEVEL=info
